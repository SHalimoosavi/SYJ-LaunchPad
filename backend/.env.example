# --- Core ---
ENVIRONMENT=development            # development | staging | production
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string   # openssl rand -hex 32
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql+asyncpg://syj:syj@localhost:5432/syj_launchpad
DATABASE_URL_SYNC=postgresql+psycopg2://syj:syj@localhost:5432/syj_launchpad

# --- Auth / JWT ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SIWE_NONCE_TTL_SECONDS=300

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=100/minute

# --- Chains (comma-separated chain IDs enabled at runtime) ---
ENABLED_CHAIN_IDS=1,56,137,8453,42161,10,43114

# RPC URLs — one per chain id, e.g. RPC_URL_1, RPC_URL_56 ...
RPC_URL_1=
RPC_URL_56=
RPC_URL_137=
RPC_URL_8453=
RPC_URL_42161=
RPC_URL_10=
RPC_URL_43114=
